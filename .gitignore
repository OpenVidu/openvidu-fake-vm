# Generated at runtime by start.sh (SSH keypair + per-VM known_hosts).
.ssh/
# Registry blobs, fake-web CA + certificates (registry.sh / fake-web.sh).
.cache/
# Artifacts you drop in to be served by fake-web.sh — never part of the repo.
www/
# The wildcard certificate for *.openvidu-local.dev, downloaded automatically by
# fake-vm.sh from https://certs.openvidu-local.dev (a real Let's Encrypt pair that
# expires and renews, so it is never versioned).
fullchain.pem
privkey.pem
# Vendored bats-core + helpers (see `make bootstrap`); a system bats is used otherwise.
tests/e2e/libs/
